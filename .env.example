# mock = deterministic fake models (free). real = OpenRouter.
LLM_MODE=mock
OPENROUTER_API_KEY=
RUBRIC_MODEL=anthropic/claude-haiku-5.5
READER_MODEL=anthropic/claude-haiku-5.5
GRADER_MODEL=anthropic/claude-haiku-5.5
# Hard cap on runtime model spend (USD), summed from llm_usage table.
LLM_BUDGET_USD=2
LLM_TIMEOUT_MS=45000
WORKER_CONCURRENCY=8
MAX_ATTEMPTS=3
# Mock tuning (load tests)
MOCK_LATENCY_MS=300
MOCK_FAIL_RATE=0
PORT=3000
DATA_DIR=./data
